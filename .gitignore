__pycache__/
*.pyc
.DS_Store
training/data/
*.pt
*.safetensors
script/

# harness_pretrain standalone runs (uv run train.py): local checkpoints,
# metrics, and chuk-train data: staging -- generated wherever it's run from,
# never meant to be committed.
ckpt/
metrics.jsonl
training/harness_pretrain/data/

# Each trainer's RUN_DIR: its replay log and stdout. Regenerated by the run
# itself, and for anything that ran on a worker the control plane holds the
# authoritative copy.
run_pretrain/
run_mathonly/
run_cells/
run_phase3/
run_mathonly_s80_colab/

# Checkpoints pulled back from the control plane -- weights, meta.json and the
# replay log, one directory per run. Hundreds of MB each, and all of it
# re-fetchable by artifact_url against the run id, so this is a cache and not a
# source.
runs/

# Generated by training/export_repl_checkpoint.py from a checkpoint directory:
# weights plus the config.json that describes them. Reproducible, so not
# committed; *.pt was already ignored above, but config.json was not.
model_v11/

# The published tokenizer's binary vocabulary, fetched with
#   hf download chrishayuk/v11-tokenizer v11.vocab.bin --local-dir .
# Act 2b's argument is that this is a PUBLISHED artifact a viewer can pull for
# themselves, so vendoring a copy here would quietly work against the point.
v11.vocab.bin
